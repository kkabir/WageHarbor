@page "/help"
@attribute [Authorize]
@inherits AppComponentBase

<PageTitle>Help · WageHarbor</PageTitle>

<PageHeader Title="Help" Subtitle="Step-by-step guides with pictures. Pick the one that fits you." />

<div class="row g-3 mb-4">
    @if (isCompanyAdmin)
    {
        <div class="col-lg-6">
            <a class="pc-card guide-card d-block h-100 text-reset" href="help/company">
                <div class="icon tone-primary"><i class="bi bi-buildings"></i></div>
                <h2>Company guide</h2>
                <p class="text-muted mb-2">For owners, HR and payroll staff: set up your company, add employees, give them logins, approve time and run payroll.</p>
                <span class="small fw-semibold">Read the company guide →</span>
            </a>
        </div>
    }
    <div class="col-lg-6">
        <a class="pc-card guide-card d-block h-100 text-reset" href="help/employee">
            <div class="icon tone-success"><i class="bi bi-person-badge"></i></div>
            <h2>Employee guide</h2>
            <p class="text-muted mb-2">For everyone with a login: see and print your pay stubs, clock in and out, request time off and keep your details up to date.</p>
            <span class="small fw-semibold">Read the employee guide →</span>
        </a>
    </div>
</div>

<div class="pc-card">
    <h2 class="mb-3">Quick answers</h2>
    <dl class="guide-faq mb-0">
        <dt>I forgot my password.</dt>
        <dd>Use <strong>Forgot your password?</strong> on the sign-in page, or ask your company's WageHarbor administrator to reset it for you.</dd>
        <dt>Where are my pay stubs?</dt>
        <dd>Under <a href="me/pay">My pay</a>. A pay stub appears once your company marks that payroll as paid.</dd>
        <dt>How do I change my password or turn on two-step sign-in?</dt>
        <dd>Click your email at the top right to open <a href="Account/Manage">Account settings</a>, then choose <strong>Password</strong> or <strong>Two-factor authentication</strong>.</dd>
        <dt>Who can see my information?</dt>
        <dd>Only people at your own company with the right role. Other companies on WageHarbor can never see your data. Social Security and bank numbers are encrypted and shown masked.</dd>
    </dl>
</div>

@code {
    private bool isCompanyAdmin;

    protected override async Task OnInitializedAsync() => isCompanyAdmin = await Me.CanManagePeopleAsync();
}
