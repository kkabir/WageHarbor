@layout Paycrest.Components.Layout.PublicLayout
@attribute [AllowAnonymous]

<PageTitle>Company guide · WageHarbor</PageTitle>
<HeadContent>
    <meta name="description" content="Step-by-step guide for small business owners: register your company on WageHarbor, add employees, give them logins, approve time and run payroll." />
    <link rel="canonical" href="https://www.wageharbor.com/help/company" />
</HeadContent>

<PageHeader Title="Company guide" Subtitle="Everything an owner, HR or payroll person needs, from sign-up to the first paid payroll.">
    <Crumbs><a href="help">Help</a> / Company guide</Crumbs>
    <ChildContent>
        <button class="btn btn-outline-secondary" onclick="paycrest.print()"><i class="bi bi-printer me-1"></i>Print guide</button>
    </ChildContent>
</PageHeader>

<div class="guide">
    <nav class="guide-toc no-print" aria-label="On this page">
        <div class="guide-toc-title">On this page</div>
        <a href="help/company#register">1. Register your company</a>
        <a href="help/company#setup">2. Finish company setup</a>
        <a href="help/company#logo">3. Add your logo</a>
        <a href="help/company#employees">4. Add employees</a>
