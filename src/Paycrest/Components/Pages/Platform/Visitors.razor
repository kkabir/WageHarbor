@page "/platform/visitors"
@attribute [Authorize(Roles = AppRoles.PlatformOwner)]
@inherits AppComponentBase

<PageTitle>Visitor log · WageHarbor platform</PageTitle>

<PageHeader Title="Visitor log" Subtitle="@($"Page views on the whole site. No IP addresses or emails are kept: unique visitors are counted per day with a hash that can't be traced back. Views older than {VisitorLogWriter.KeepDays} days are deleted.")">
    <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
</PageHeader>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <div class="btn-group btn-group-sm" role="group" aria-label="Period">
        @foreach (var (days, label) in Periods)
        {
            <button class="btn @(period == days ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetPeriod(days)">@label</button>
        }
    </div>
    <div class="form-check form-switch ms-2">
        <input class="form-check-input" type="checkbox" id="vl-bots" checked="@includeBots" @onchange="ToggleBots" />
        <label class="form-check-label small" for="vl-bots">Include bots and crawlers</label>
    </div>
    <div class="form-check form-switch ms-2">
        <input class="form-check-input" type="checkbox" id="vl-signed" checked="@publicOnly" @onchange="TogglePublic" />
        <label class="form-check-label small" for="vl-signed">Public visitors only (not signed in)</label>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><StatCard Label="Page views" Value="@stats.Views.ToString("N0")" Icon="eye" Tone="primary" /></div>
    <div class="col-6 col-xl-3"><StatCard Label="Unique visitors" Value="@stats.Visitors.ToString("N0")" Icon="people" Tone="info" Hint="Counted per day" /></div>
    <div class="col-6 col-xl-3"><StatCard Label="Signed-in views" Value="@stats.SignedIn.ToString("N0")" Icon="person-check" Tone="success" /></div>
    <div class="col-6 col-xl-3"><StatCard Label="Bot views" Value="@stats.Bots.ToString("N0")" Icon="robot" Tone="warning" Hint="@(includeBots ? "Included above" : "Not included above")" /></div>
</div>

<div class="pc-card mb-4">
    <h2 class="mb-3">Views per day</h2>
    @if (daily.Count == 0)
    {
        <p class="text-muted small mb-0">No views in this period yet.</p>
    }
    else
    {
        var max = Math.Max(1, daily.Max(d => d.Views));
        <div class="visit-chart" role="img" aria-label="Page views per day">
            @foreach (var d in daily)
            {
                <div class="visit-bar" title="@($"{d.Day:ddd MMM d}: {d.Views:N0} views, {d.Visitors:N0} visitors")">
                    <div class="visit-bar-fill" style="height:@((d.Views * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    <div class="visit-bar-label">@(daily.Count <= 14 ? d.Day.ToString("M/d") : d.Day.Day == 1 || d == daily[0] ? d.Day.ToString("M/d") : "")</div>
                </div>
            }
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="pc-card h-100">
            <h2 class="mb-3">Top pages</h2>
            <TopList Rows="topPages" Empty="No pages yet." />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="pc-card h-100">
            <h2 class="mb-3">Where visitors came from</h2>
            <TopList Rows="topReferrers" Empty="No outside links yet. Visitors who type the address or use a bookmark don't show here." />
        </div>
    </div>
    <div class="col-md-4">
        <div class="pc-card h-100"><h2 class="mb-3">Devices</h2><TopList Rows="devices" Empty="—" /></div>
    </div>
    <div class="col-md-4">
        <div class="pc-card h-100"><h2 class="mb-3">Browsers</h2><TopList Rows="browsers" Empty="—" /></div>
    </div>
    <div class="col-md-4">
        <div class="pc-card h-100">
            <h2 class="mb-3">Countries</h2>
            <TopList Rows="countries" Empty="Country isn't known: the host doesn't send it. It appears if the site is put behind Cloudflare." />
        </div>
    </div>
</div>

<div class="pc-card p-0">
    <div class="d-flex flex-wrap p-3 border-bottom align-items-center gap-2">
        <h2 class="m-0">Latest views</h2>
        <input class="form-control form-control-sm ms-auto" style="max-width:260px" placeholder="Filter by page or source…" @bind="search" @bind:event="oninput" />
    </div>
    @if (FilteredRecent.Count == 0)
    {
        <EmptyState Icon="eye" Title="No views here">Nothing matches.</EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Time</th><th>Page</th><th>Came from</th><th>Device</th><th>Country</th><th>Visitor</th></tr></thead>
                <tbody>
                    @foreach (var v in FilteredRecent)
                    {
                        <tr>
                            <td class="small text-nowrap">@Local(v.TimeUtc)</td>
                            <td class="small text-break">@v.Path @if (v.StatusCode >= 400) { <span class="chip tone-danger ms-1">@v.StatusCode</span> }</td>
                            <td class="small text-muted text-break">@(v.Referrer ?? "—")</td>
                            <td class="small text-nowrap">@v.Device@(v.Browser is { } b ? " · " + b : "")</td>
                            <td class="small">@(v.Country ?? "—")@(v.Language is { } l ? " · " + l : "")</td>
                            <td class="small text-nowrap">@if (v.SignedIn) { <span class="chip tone-success plain">Signed in</span> } else { <code class="small text-muted" title="Same code = same visitor that day">@v.VisitorHash?[..6]</code> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="small text-muted p-3 border-top">Showing the latest @recent.Count views in this period.</div>
    }
</div>

@code {
    private static readonly (int Days, string Label)[] Periods = [(1, "Today"), (7, "7 days"), (30, "30 days"), (90, "90 days"), (180, "180 days")];

    private sealed record Stats(int Views, int Visitors, int SignedIn, int Bots);
    public sealed record TopRow(string Name, int Count);

    private sealed record DayRow(DateTime Day, int Views, int Visitors);

    private int period = 7;
    private bool includeBots, publicOnly;
    private string search = "";
    private Stats stats = new(0, 0, 0, 0);
    private List<DayRow> daily = [];
    private List<TopRow> topPages = [], topReferrers = [], devices = [], browsers = [], countries = [];
    private List<PageVisit> recent = [];
    private TimeZoneInfo zone = TimeZoneInfo.Utc;

    private List<PageVisit> FilteredRecent => string.IsNullOrWhiteSpace(search)
        ? recent
        : recent.Where(v => $"{v.Path} {v.Referrer}".Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try { zone = TimeZoneInfo.FindSystemTimeZoneById("America/New_York"); } catch { }
        await LoadAsync();
    }

    private async Task SetPeriod(int days) { period = days; await LoadAsync(); }
    private async Task ToggleBots(ChangeEventArgs e) { includeBots = (bool)e.Value!; await LoadAsync(); }
    private async Task TogglePublic(ChangeEventArgs e) { publicOnly = (bool)e.Value!; await LoadAsync(); }

    private string Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), zone).ToString("MMM d h:mm tt");

    private async Task LoadAsync()
    {
        // Periods are whole days in Eastern time; "Today" starts at midnight ET.
        var nowLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zone);
        var startLocal = nowLocal.Date.AddDays(1 - period);
        var fromUtc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(startLocal, DateTimeKind.Unspecified), zone);

        await using var db = await Dbs.OpenPlatformAsync();
        var inPeriod = db.PageVisits.AsNoTracking().Where(v => v.TimeUtc >= fromUtc);
        var bots = await inPeriod.CountAsync(v => v.Device == "Bot");
        var q = inPeriod;
        if (!includeBots) q = q.Where(v => v.Device != "Bot");
        if (publicOnly) q = q.Where(v => !v.SignedIn);

        // Group by day in memory: the period holds at most a few hundred thousand small rows, and time zones are easier here.
        var slim = await q.Select(v => new { v.TimeUtc, v.VisitorHash, v.SignedIn, v.Path, v.Referrer, v.Device, v.Browser, v.Country }).ToListAsync();
        var withDay = slim.Select(v => new { v, Day = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(v.TimeUtc, DateTimeKind.Utc), zone).Date }).ToList();

        stats = new Stats(slim.Count,
            withDay.Where(x => !x.v.SignedIn).Select(x => (x.Day, x.v.VisitorHash)).Distinct().Count(),
            slim.Count(v => v.SignedIn), bots);
        var byDay = withDay.GroupBy(x => x.Day).ToDictionary(g => g.Key, g => new DayRow(g.Key, g.Count(), g.Where(x => !x.v.SignedIn).Select(x => x.v.VisitorHash).Distinct().Count()));
        daily = Enumerable.Range(0, period).Select(i => startLocal.AddDays(i)).Select(d => byDay.GetValueOrDefault(d) ?? new DayRow(d, 0, 0)).ToList();

        static List<TopRow> Top(IEnumerable<string?> values, int n = 12) => values.Where(x => !string.IsNullOrEmpty(x))
            .GroupBy(x => x!).Select(g => new TopRow(g.Key, g.Count())).OrderByDescending(r => r.Count).ThenBy(r => r.Name).Take(n).ToList();
        topPages = Top(slim.Select(v => v.Path), 15);
        topReferrers = Top(slim.Select(v => v.Referrer), 15);
        devices = Top(slim.Select(v => v.Device));
        browsers = Top(slim.Select(v => v.Browser));
        countries = Top(slim.Select(v => v.Country));

        recent = await q.OrderByDescending(v => v.Id).Take(200).ToListAsync();
    }
}
