@page "/not-found"
@layout Paycrest.Components.Layout.PublicLayout
@attribute [AllowAnonymous]

<PageTitle>@L["Page not found · WageHarbor"]</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="prose text-center py-5">
    <h1>@L["Page not found"]</h1>
    <p class="prose-sub">@L["Sorry, we couldn't find that page. It may have moved, or the link may be mistyped."]</p>
    <div class="d-flex flex-wrap gap-2 justify-content-center">
        <a href="" class="btn btn-primary">@L["Go to the home page"]</a>
        <a href="help" class="btn btn-outline-secondary">@L["Help & guides"]</a>
        <a href="contact" class="btn btn-outline-secondary">@L["Contact us"]</a>
    </div>
</div>
