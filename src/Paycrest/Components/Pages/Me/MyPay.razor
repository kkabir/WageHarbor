@page "/me/pay"
@attribute [Authorize]
@inherits AppComponentBase

<PageTitle>@L["My pay · WageHarbor"]</PageTitle>

<PageHeader Title="@L["My pay"]" Subtitle="@L["Pay stubs, year-to-date totals and where your pay goes."]" />

@if (myId == null)
{
    <NoEmployeeRecord />
    return;
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3"><StatCard Label="@L["{0} gross pay", year]" Value="@Fmt.Money(ytd.Sum(p => p.GrossPay))" Icon="wallet2" /></div>
    <div class="col-6 col-xl-3"><StatCard Label="@L["{0} taxes", year]" Value="@Fmt.Money(ytd.Sum(p => p.EmployeeTaxes))" Icon="bank" Tone="warning" /></div>
    <div class="col-6 col-xl-3"><StatCard Label="@L["{0} deductions", year]" Value="@Fmt.Money(ytd.Sum(p => p.PreTaxDeductions + p.PostTaxDeductions))" Icon="heart-pulse" Tone="info" /></div>
    <div class="col-6 col-xl-3"><StatCard Label="@L["{0} net pay", year]" Value="@Fmt.Money(ytd.Sum(p => p.NetPay))" Icon="cash" Tone="success" /></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="pc-card p-0">
            <div class="d-flex align-items-center p-3 border-bottom">
                <div class="fw-semibold">@L["Pay stubs"]</div>
                <select class="form-select form-select-sm ms-auto" style="max-width:120px" value="@year" @onchange="YearChanged">
                    @foreach (var y in years) { <option value="@y">@y</option> }
                </select>
            </div>
            @if (ytd.Count == 0)
            {
                <EmptyState Icon="receipt" Title="@L["No pay stubs for this year"]" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>@L["Pay date"]</th><th>@L["Period"]</th><th class="num">@L["Gross"]</th><th class="num">@L["Taxes"]</th><th class="num">@L["Net"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in ytd.OrderByDescending(p => p.PayDate))
                            {
                                <tr class="clickable" @onclick="@(() => Nav.NavigateTo($"paystub/{p.Id}"))">
                                    <td class="fw-semibold">@Fmt.Date(p.PayDate)</td>
                                    <td class="small">@p.PeriodStart.ToString("MMM d") – @p.PeriodEnd.ToString("MMM d")</td>
                                    <td class="num">@Fmt.Money(p.GrossPay)</td>
                                    <td class="num">@Fmt.Money(p.EmployeeTaxes)</td>
                                    <td class="num fw-bold">@Fmt.Money(p.NetPay)</td>
                                    <td class="text-end"><i class="bi bi-chevron-right text-muted"></i></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="pc-card mb-3">
            <h2 class="mb-3">@L["Tax forms"]</h2>
            @if (formYears.Count == 0)
            {
                <p class="small text-muted mb-0">@L["Your W-2 (or 1099-NEC) appears here after your first paid payroll."]</p>
            }
            else
            {
                <ul class="list-clean small mb-0">
                    @foreach (var y in formYears)
                    {
                        <li class="d-flex align-items-center"><i class="bi bi-file-earmark-text text-primary me-2"></i>@(y >= DateTime.Today.Year ? L["{0} for {1} (so far)", isContractor ? "1099-NEC" : "W-2", y] : L["{0} for {1}", isContractor ? "1099-NEC" : "W-2", y])<a class="ms-auto" href="@(isContractor ? "forms/1099-nec" : "forms/w2")/@y">@L["View"]</a></li>
                    }
                </ul>
            }
        </div>
        <div class="pc-card mb-3">
            <h2 class="mb-3">@L["Direct deposit"]</h2>
            @if (banks.Count == 0) { <div class="text-muted small">@L["Paid by paper check."]</div> }
            @foreach (var b in banks)
            {
                <div class="d-flex justify-content-between small py-1">
                    <span><i class="bi bi-bank me-1"></i>@b.BankName @L[b.AccountType.ToString()] @SensitiveData.MaskAccount(b.AccountLast4)</span>
                    <span>@(b.SplitType switch { DepositSplitType.FixedAmount => Fmt.Money(b.SplitValue), DepositSplitType.Percent => $"{b.SplitValue:0.##}%", _ => L["Remainder"] })</span>
                </div>
            }
            <div class="form-text mt-2">@L["To change bank details, contact HR. For your security, changes are verified."]</div>
        </div>
        <div class="pc-card">
            <h2 class="mb-3">@L["Benefits & deductions"]</h2>
            @if (deductions.Count == 0) { <div class="text-muted small">@L["None"]</div> }
            @foreach (var d in deductions)
            {
                <div class="d-flex justify-content-between small py-1">
                    <span>@d.DeductionType!.Name</span>
                    <span>@(d.IsPercentOfGross ? $"{d.Amount:0.##}%" : Fmt.Money(d.Amount))</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int? myId;
    private int year = DateTime.Today.Year;
    private List<int> years = [];
    private List<int> formYears = [];
    private bool isContractor;
    private List<Paycheck> ytd = [];
    private List<EmployeeBankAccount> banks = [];
    private List<EmployeeDeduction> deductions = [];

    protected override async Task OnInitializedAsync()
    {
        myId = await Me.GetEmployeeIdAsync();
        if (myId == null) return;
        await using var db = await Dbs.OpenAsync();
        years = await db.Paychecks.Where(p => p.EmployeeId == myId && p.PayrollRun!.Status == PayrollRunStatus.Paid)
            .Select(p => p.PayDate.Year).Distinct().OrderByDescending(y => y).ToListAsync();
        formYears = years.ToList();
        isContractor = await db.Employees.Where(e => e.Id == myId).Select(e => e.EmploymentType == EmploymentType.Contractor1099).FirstOrDefaultAsync();
        if (!years.Contains(year)) years.Insert(0, year);
        banks = await db.EmployeeBankAccounts.AsNoTracking().Where(b => b.EmployeeId == myId && b.IsActive).ToListAsync();
        deductions = await db.EmployeeDeductions.AsNoTracking().Include(d => d.DeductionType).Where(d => d.EmployeeId == myId && d.IsActive).ToListAsync();
        await LoadYear();
    }

    private async Task YearChanged(ChangeEventArgs e)
    {
        year = int.Parse(e.Value!.ToString()!);
        await LoadYear();
    }

    private async Task LoadYear()
    {
        await using var db = await Dbs.OpenAsync();
        ytd = await db.Paychecks.AsNoTracking()
            .Where(p => p.EmployeeId == myId && p.PayDate.Year == year && p.PayrollRun!.Status == PayrollRunStatus.Paid).ToListAsync();
    }
}
