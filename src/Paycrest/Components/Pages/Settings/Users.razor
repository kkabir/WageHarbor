@page "/settings/users"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits AppComponentBase
@using Microsoft.AspNetCore.Identity
@using Paycrest.Data
@inject UserManager<ApplicationUser> UserManager
@inject AccountEmails AccountMail

<PageTitle>Users & roles · WageHarbor</PageTitle>

<PageHeader Title="Users & roles" Subtitle="Who can sign in and what they can do. Create employee logins from the employee's Self-service tab." />

<div class="row g-3">
    <div class="col-xl-8">
        <div class="pc-card p-0">
            <table class="table align-middle">
                <thead><tr><th>User</th><th>Employee</th><th>Roles</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr>
                            <td><PersonCell Name="@(u.Email ?? u.UserName ?? "")" Sub="@(u.TwoFactorEnabled ? "2FA on" : "2FA off")" /></td>
                            <td>@(links.TryGetValue(u.Id, out var emp) ? emp : "—")</td>
                            <td>@foreach (var r in roles.GetValueOrDefault(u.Id) ?? []) { <span class="chip tone-primary plain me-1">@r</span> }</td>
                            <td>
                                @switch (UserStates.Of(u))
                                {
                                    case UserState.Deactivated: <span class="chip tone-danger">Deactivated</span> break;
                                    case UserState.Locked: <span class="chip tone-warning" title="Too many wrong passwords; unlocks by itself">Locked</span> break;
                                    default: <span class="chip tone-success">Active</span> break;
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (u.Id != myId)
                                {
                                    if (UserStates.Of(u) == UserState.Active)
                                    {
                                        <button class="btn btn-sm btn-outline-danger me-1" disabled="@Busy" @onclick="() => confirming = u">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success me-1" disabled="@Busy" @onclick="() => SetActive(u, true)">@(UserStates.Of(u) == UserState.Locked ? "Unlock" : "Activate")</button>
                                    }
                                }
                                <button class="btn btn-sm btn-light" title="Roles and password" @onclick="() => Edit(u)"><i class="bi bi-pencil"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="pc-card">
            <h2 class="mb-2">Roles</h2>
            <dl class="small mb-0">
                <dt>Admin</dt><dd>Everything, including users, roles and audit log.</dd>
                <dt>Payroll</dt><dd>Run, approve and pay payroll; employees; reports; tax tables.</dd>
                <dt>HR</dt><dd>Employees, time off, documents, reports, settings. Can preview but not approve payroll.</dd>
                <dt>Manager</dt><dd>Approves time and time off for direct reports.</dd>
                <dt>Employee</dt><dd>Self-service: pay stubs, W-4, time clock, time off.</dd>
            </dl>
        </div>
    </div>
</div>

<Modal @bind-Show="showEdit" Title="@($"Edit {editing?.Email}")">
    <ChildContent>
        @if (editing != null)
        {
            <label class="form-label">Roles</label>
            <div class="d-flex flex-wrap gap-3 mb-3">
                @foreach (var r in AppRoles.All)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="ur-@r" checked="@editRoles.Contains(r)" @onchange="e => ToggleRole(r, (bool)e.Value!)" />
                        <label class="form-check-label" for="ur-@r">@r</label>
                    </div>
                }
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary btn-sm" disabled="@Busy" @onclick="EmailResetLink" title="They choose a new password themselves; nobody else sees it"><i class="bi bi-envelope me-1"></i>Email a password reset link</button>
                <button class="btn btn-link btn-sm text-muted" disabled="@Busy" @onclick="ResetPassword" title="For someone who can't get email">Set a temporary password instead</button>
            </div>
            @if (newPassword != null)
            {
                <div class="alert alert-success small mt-3">Temporary password: <code class="fs-6">@newPassword</code> — share it securely; it won't be shown again.</div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showEdit = false">Close</button>
        <button class="btn btn-primary" disabled="@Busy" @onclick="SaveRoles">Save roles</button>
    </Footer>
</Modal>

<Modal Show="confirming != null" ShowChanged="v => { if (!v) confirming = null; }" Title="Deactivate user">
    <ChildContent>
        <p class="mb-0">Deactivate <strong>@confirming?.Email</strong>? They won't be able to sign in until you activate them again, and they're signed out within 30 minutes. Nothing they entered is deleted.</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => confirming = null">Cancel</button>
        <button class="btn btn-danger" disabled="@Busy" @onclick="() => SetActive(confirming!, false)">Deactivate</button>
    </Footer>
</Modal>

@code {
    private ApplicationUser? confirming;
    private string? myId;
    private List<ApplicationUser> users = [];
    private Dictionary<string, IList<string>> roles = [];
    private Dictionary<string, string> links = [];
    private ApplicationUser? editing;
    private HashSet<string> editRoles = [];
    private bool showEdit;
    private string? newPassword;

    protected override async Task OnInitializedAsync()
    {
        myId = await Me.GetUserIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var companyId = await Me.GetCompanyIdAsync();
        users = companyId == null ? [] : await UserManager.Users.AsNoTracking().Where(u => u.CompanyId == companyId).OrderBy(u => u.Email).ToListAsync();
        roles.Clear();
        foreach (var u in users) roles[u.Id] = await UserManager.GetRolesAsync(u);
        await using var db = await Dbs.OpenAsync();
        links = await db.Employees.Where(e => e.UserId != null).ToDictionaryAsync(e => e.UserId!, e => e.FirstName + " " + e.LastName);
    }

    private void Edit(ApplicationUser u)
    {
        editing = u;
        editRoles = (roles.GetValueOrDefault(u.Id) ?? []).ToHashSet();
        newPassword = null;
        showEdit = true;
    }

    private void ToggleRole(string role, bool on) { if (on) editRoles.Add(role); else editRoles.Remove(role); }

    private async Task<ApplicationUser> Tracked()
    {
        var u = await UserManager.FindByIdAsync(editing!.Id);
        if (u == null || u.CompanyId == null || u.CompanyId != await Me.GetCompanyIdAsync()) throw new InvalidOperationException("User not found.");
        return u;
    }

    private async Task SaveRoles()
    {
        var ok = await RunAsync(async () =>
        {
            var u = await Tracked();
            if (u.Id == await Me.GetUserIdAsync() && !editRoles.Contains(AppRoles.Admin))
                throw new InvalidOperationException("You can't remove your own Admin role.");
            // Company roles only; a platform owner keeps that role.
            var current = (await UserManager.GetRolesAsync(u)).Where(AppRoles.All.Contains).ToList();
            await UserManager.RemoveFromRolesAsync(u, current.Except(editRoles));
            await UserManager.AddToRolesAsync(u, editRoles.Except(current));
            await LogAsync("RolesChanged", u.Id, string.Join(",", editRoles));
        }, "Roles updated. They apply at the user's next sign-in.");
        if (ok) showEdit = false;
        await LoadAsync();
    }

    private async Task EmailResetLink()
    {
        await RunAsync(async () =>
        {
            var u = await Tracked();
            await using var db = await Dbs.OpenAsync();
            var companyName = await db.Companies.Select(c => c.Name).FirstAsync();
            if (await AccountMail.SendSetPasswordAsync(u, companyName, isNew: false) is { } error)
                throw new InvalidOperationException($"The email couldn't be sent ({error}). Use \"Set a temporary password instead\".");
            newPassword = null;
            await LogAsync("PasswordResetEmailed", u.Id, null);
        }, $"Emailed {editing?.Email} a link to choose a new password.");
    }

    private async Task ResetPassword()
    {
        await RunAsync(async () =>
        {
            var u = await Tracked();
            var token = await UserManager.GeneratePasswordResetTokenAsync(u);
            var pwd = EmployeeService.GeneratePassword();
            var result = await UserManager.ResetPasswordAsync(u, token, pwd);
            if (!result.Succeeded) throw new InvalidOperationException(string.Join(" ", result.Errors.Select(e => e.Description)));
            newPassword = pwd;
            await LogAsync("PasswordReset", u.Id, null);
        });
    }

    private async Task SetActive(ApplicationUser target, bool active)
    {
        var ok = await RunAsync(async () =>
        {
            editing = target;
            var u = await Tracked();
            if (!active && u.Id == myId) throw new InvalidOperationException("You can't deactivate your own account.");
            await UserStates.SetActiveAsync(UserManager, u, active);
            await LogAsync(active ? "UserEnabled" : "UserDisabled", u.Id, null);
        }, active ? $"{target.Email} can sign in again." : $"{target.Email} is deactivated.");
        if (ok) confirming = null;
        await LoadAsync();
    }

    private async Task LogAsync(string action, string userId, string? details)
    {
        await using var db = await Dbs.OpenAsync();
        db.AuditLogs.Add(new AuditLog { CompanyId = db.CurrentCompanyId, UserName = await Me.GetNameAsync(), Action = action, EntityType = "User", EntityId = userId, Details = details });
        await db.SaveChangesAsync();
    }
}
