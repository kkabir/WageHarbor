@page "/onboard/{Token}"
@layout Paycrest.Components.Layout.PublicLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject OnboardingService Onboarding

<PageTitle>@L["Set up your pay · WageHarbor"]</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<div class="onb">
    @if (done)
    {
        <div class="pc-card text-center py-5">
            <div class="contact-done"><i class="bi bi-check2"></i></div>
            <h1 class="h3 fw-bold">@L["You're all set, {0}!", view?.Employee.PreferredName ?? view?.Employee.FirstName]</h1>
            <p class="text-muted">@L["Your details are saved and {0} can now pay you. Sign in any time to see your pay stubs, time off and tax forms.", view?.CompanyName]</p>
            <a href="Account/Login" class="btn btn-primary btn-lg mt-2">@L["Sign in"]</a>
            <p class="small text-muted mt-3 mb-0">@L.Html("New to WageHarbor? The <a href=\"help/employee\">employee guide</a> shows you around.")</p>
        </div>
    }
    else if (view == null)
    {
        <div class="pc-card text-center py-5">
            <i class="bi bi-link-45deg" style="font-size:3rem;color:var(--pc-muted)"></i>
            <h1 class="h4 fw-bold mt-2">@L["This link has expired or was already used"]</h1>
            <p class="text-muted mb-0">@L["Onboarding links work once and last {0} days. Please ask your employer to send you a new one.", OnboardingService.LinkLifetime.Days]</p>
        </div>
    }
    else
    {
        <div class="onb-head">
            <div class="small text-muted text-uppercase fw-semibold" style="letter-spacing:.08em">@view.CompanyName</div>
            <h1>@L["Welcome, {0}! Let's set up your pay.", view.Employee.PreferredName ?? view.Employee.FirstName]</h1>
            <p class="text-muted">@L["About 10 minutes. Have your bank details handy. Everything is sent securely, and your Social Security and account numbers are encrypted."]</p>
        </div>

        @if (problems.Count > 0)
        {
            <div class="alert alert-danger"><strong>@L["Please fix the following:"]</strong><ul class="mb-0 mt-1">@foreach (var p in problems) { <li>@L[p]</li> }</ul></div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="onboard" Enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummaryText class="alert alert-danger small" />

            <section class="pc-card onb-step">
                <h2><span class="num">1</span>@L["About you"]</h2>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">@L["Legal name"]</label><input class="form-control" value="@view.Employee.LegalName" disabled /><div class="form-text">@L["Wrong? Tell your employer."]</div></div>
                    <div class="col-md-6"><label class="form-label" for="pn">@L["Preferred first name"]</label><InputText id="pn" class="form-control" @bind-Value="Input.PreferredName" /></div>
                    <div class="col-md-4"><label class="form-label" for="ph">@L["Phone *"]</label><InputText id="ph" type="tel" class="form-control" @bind-Value="Input.Phone" autocomplete="tel" /></div>
                    <div class="col-md-4"><label class="form-label" for="dob">@L["Date of birth *"]</label><InputDate id="dob" class="form-control" @bind-Value="Input.DateOfBirth" /></div>
                    <div class="col-md-4"><label class="form-label" for="ssn">@L["Social Security number *"]</label><InputText id="ssn" class="form-control" @bind-Value="Input.Ssn" autocomplete="off" placeholder="123-45-6789" /></div>
                    <div class="col-md-8"><label class="form-label" for="a1">@L["Home address *"]</label><InputText id="a1" class="form-control" @bind-Value="Input.AddressLine1" autocomplete="address-line1" /></div>
                    <div class="col-md-4"><label class="form-label" for="a2">@L["Apt / unit"]</label><InputText id="a2" class="form-control" @bind-Value="Input.AddressLine2" autocomplete="address-line2" /></div>
                    <div class="col-md-5"><label class="form-label" for="city">@L["City *"]</label><InputText id="city" class="form-control" @bind-Value="Input.City" autocomplete="address-level2" /></div>
                    <div class="col-md-3"><label class="form-label" for="st">@L["State *"]</label><InputSelect id="st" class="form-select" @bind-Value="Input.State"><option value="">@L["Choose…"]</option>@foreach (var s in Fmt.States) { <option value="@s">@s</option> }</InputSelect></div>
                    <div class="col-md-4"><label class="form-label" for="zip">@L["ZIP *"]</label><InputText id="zip" class="form-control" @bind-Value="Input.PostalCode" autocomplete="postal-code" /></div>
                    <div class="col-md-5"><label class="form-label" for="ecn">@L["Emergency contact"]</label><InputText id="ecn" class="form-control" @bind-Value="Input.EmergencyContactName" /></div>
                    <div class="col-md-4"><label class="form-label" for="ecp">@L["Their phone"]</label><InputText id="ecp" type="tel" class="form-control" @bind-Value="Input.EmergencyContactPhone" /></div>
                    <div class="col-md-3"><label class="form-label" for="ecr">@L["Relationship"]</label><InputText id="ecr" class="form-control" @bind-Value="Input.EmergencyContactRelation" /></div>
                </div>
            </section>

            <section class="pc-card onb-step">
                <h2><span class="num">2</span>@L["Tax withholding (Form W-4)"]</h2>
                <p class="small text-muted">@L.Html("This decides how much federal income tax comes out of each paycheck. Most people only need Step 1. The <a href=\"https://www.irs.gov/individuals/tax-withholding-estimator\" target=\"_blank\" rel=\"noopener\">IRS withholding estimator</a> can help.")</p>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" for="fs">@L["Step 1(c): filing status"]</label><InputSelect id="fs" class="form-select" @bind-Value="Input.FilingStatus"><option value="@FilingStatus.Single">@L["Single or married filing separately"]</option><option value="@FilingStatus.MarriedFilingJointly">@L["Married filing jointly"]</option><option value="@FilingStatus.HeadOfHousehold">@L["Head of household"]</option></InputSelect></div>
                    <div class="col-md-6 d-flex align-items-end"><div class="form-check mb-2"><InputCheckbox id="mj" class="form-check-input" @bind-Value="Input.W4MultipleJobs" /><label class="form-check-label" for="mj">@L["Step 2: I have more than one job, or my spouse also works"]</label></div></div>
                    <div class="col-md-6"><label class="form-label" for="dep">@L["Step 3: dependents credit ($ per year)"]</label><InputNumber id="dep" class="form-control" @bind-Value="Input.W4DependentsAmount" /><div class="form-text">@L["$2,200 per child under 17, $500 per other dependent."]</div></div>
                    <div class="col-md-6"><label class="form-label" for="oi">@L["Step 4(a): other income ($ per year)"]</label><InputNumber id="oi" class="form-control" @bind-Value="Input.W4OtherIncome" /></div>
                    <div class="col-md-6"><label class="form-label" for="ded">@L["Step 4(b): deductions ($ per year)"]</label><InputNumber id="ded" class="form-control" @bind-Value="Input.W4Deductions" /></div>
                    <div class="col-md-6"><label class="form-label" for="ex">@L["Step 4(c): extra withholding per paycheck ($)"]</label><InputNumber id="ex" class="form-control" @bind-Value="Input.W4ExtraWithholding" /></div>
                    <div class="col-12"><hr class="my-1" /><div class="fw-semibold small mt-2">@L["State withholding"]</div></div>
                    <div class="col-md-6"><label class="form-label" for="sfs">@L["State filing status"]</label><InputSelect id="sfs" class="form-select" @bind-Value="Input.StateFilingStatus"><option value="@FilingStatus.Single">@L["Single"]</option><option value="@FilingStatus.MarriedFilingJointly">@L["Married"]</option><option value="@FilingStatus.HeadOfHousehold">@L["Head of household"]</option></InputSelect></div>
                    <div class="col-md-6"><label class="form-label" for="sa">@L["State allowances"]</label><InputNumber id="sa" class="form-control" @bind-Value="Input.StateAllowances" /><div class="form-text">@L["From your state's withholding form, if it uses allowances. Otherwise leave 0."]</div></div>
                </div>
            </section>

            <section class="pc-card onb-step">
                <h2><span class="num">3</span>@L["How you get paid"]</h2>
                <div class="d-flex gap-4 mb-3">
                    <div class="form-check"><input class="form-check-input" type="radio" name="Input.DirectDeposit" id="dd1" value="true" checked="@Input.DirectDeposit" /><label class="form-check-label" for="dd1">@L["Direct deposit (recommended)"]</label></div>
                    <div class="form-check"><input class="form-check-input" type="radio" name="Input.DirectDeposit" id="dd0" value="false" checked="@(!Input.DirectDeposit)" /><label class="form-check-label" for="dd0">@L["Paper check"]</label></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" for="rt">@L["Routing number"]</label><InputText id="rt" class="form-control" @bind-Value="Input.RoutingNumber" inputmode="numeric" placeholder="@L["9 digits"]" /></div>
                    <div class="col-md-6"><label class="form-label" for="at">@L["Account type"]</label><InputSelect id="at" class="form-select" @bind-Value="Input.AccountType"><option value="@BankAccountType.Checking">@L["Checking"]</option><option value="@BankAccountType.Savings">@L["Savings"]</option></InputSelect></div>
                    <div class="col-md-6"><label class="form-label" for="ac">@L["Account number"]</label><InputText id="ac" class="form-control" @bind-Value="Input.AccountNumber" inputmode="numeric" autocomplete="off" /></div>
                    <div class="col-md-6"><label class="form-label" for="ac2">@L["Account number again"]</label><InputText id="ac2" class="form-control" @bind-Value="Input.AccountNumberConfirm" inputmode="numeric" autocomplete="off" /></div>
                    <div class="col-12 form-text">@L["Both numbers are printed at the bottom of a check: routing number first, then account number. For paper checks, leave these blank."]</div>
                </div>
            </section>

            <section class="pc-card onb-step">
                <h2><span class="num">4</span>@L["Your WageHarbor login"]</h2>
                <p class="small text-muted">@L.Html("You'll sign in with <strong>{0}</strong> to see your pay stubs, W-2 and time off.", System.Net.WebUtility.HtmlEncode(view.Invite.Email))</p>
                @if (view.HasLogin)
                {
                    <p class="small mb-0"><i class="bi bi-check-circle-fill text-success me-1"></i>@L["You already have a login; no password needed."]</p>
                    <input type="hidden" name="Input.Password" value="not-used-already-has-login" />
                    <input type="hidden" name="Input.PasswordConfirm" value="not-used-already-has-login" />
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="pw">@L["Choose a password *"]</label><InputText id="pw" type="password" class="form-control" @bind-Value="Input.Password" autocomplete="new-password" /><div class="form-text">@L["At least 8 characters."]</div></div>
                        <div class="col-md-6"><label class="form-label" for="pw2">@L["Password again *"]</label><InputText id="pw2" type="password" class="form-control" @bind-Value="Input.PasswordConfirm" autocomplete="new-password" /></div>
                    </div>
                }
            </section>

            <section class="pc-card onb-step">
                <h2><span class="num">5</span>@L["Review and sign"]</h2>
                <div class="form-check mb-3"><InputCheckbox id="cert" class="form-check-input" @bind-Value="Input.Certify" /><label class="form-check-label" for="cert">@L["Under penalties of perjury, I declare that this certificate (Form W-4), to the best of my knowledge and belief, is true, correct and complete, and that the other information I've given is accurate."]</label></div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-7"><label class="form-label" for="sig">@L["Type your full legal name to sign *"]</label><InputText id="sig" class="form-control onb-sign" @bind-Value="Input.SignedName" placeholder="@L["Type your full name"]" autocomplete="off" /></div>
                    <div class="col-md-5"><div class="small text-muted">@L["Date: {0}", DateTime.Today.ToString("MMMM d, yyyy")]</div></div>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4"><i class="bi bi-check2-circle me-1"></i>@L["Save and finish"]</button>
                <p class="small text-muted text-center mt-2 mb-0">@L["Typing your name is your electronic signature. Your employer keeps a record with the date."]</p>
            </section>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = "";
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private OnboardingInput Input { get; set; } = default!;

    private OnboardingView? view;
    private List<string> problems = [];
    private bool done;

    protected override async Task OnInitializedAsync()
    {
        view = await Onboarding.FindAsync(Token);
        if (Input == null)
        {
            Input = new();
            if (view != null)
            {
                // Start from whatever the employer already entered.
                var e = view.Employee;
                Input.PreferredName = e.PreferredName;
                Input.Phone = e.Phone ?? "";
                Input.DateOfBirth = e.DateOfBirth;
                Input.AddressLine1 = e.AddressLine1 ?? "";
                Input.AddressLine2 = e.AddressLine2;
                Input.City = e.City ?? "";
                Input.State = e.State;
                Input.PostalCode = e.PostalCode ?? "";
                Input.FilingStatus = e.FilingStatus;
                Input.StateFilingStatus = e.StateFilingStatus;
            }
        }
    }

    private async Task SubmitAsync()
    {
        if (view == null) return;
        problems = await Onboarding.CompleteAsync(Token, Input, HttpContext.Connection.RemoteIpAddress?.ToString());
        done = problems.Count == 0;
    }
}
