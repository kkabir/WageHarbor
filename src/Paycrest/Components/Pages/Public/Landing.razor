<SeoTags Path="/" Title="@L["WageHarbor · Free payroll & HR for small business"]" Description="@L["Payroll and HR for small businesses at about a quarter of the usual price, free for one employee: automatic payroll taxes, direct deposit, printable pay stubs, time clock, time off and employee self-service."]" ShareDescription="@L["Run payroll in minutes, pay your people on time, and give every employee their own login for pay stubs, time off and the time clock."]" Translated="true">
    <script type="application/ld+json">{"@@context":"https://schema.org","@@graph":[{"@@type":"Organization","@@id":"https://www.wageharbor.com/#org","name":"WageHarbor","url":"https://www.wageharbor.com/","logo":"https://www.wageharbor.com/brand/wageharbor-mark-email.png"},{"@@type":"WebSite","@@id":"https://www.wageharbor.com/#site","name":"WageHarbor","url":"https://www.wageharbor.com/","publisher":{"@@id":"https://www.wageharbor.com/#org"},"inLanguage":["en","es","zh-Hans","vi","fil","ar","ko","fr","pt","ru","ht","hi","bn","ur"]},{"@@type":"SoftwareApplication","name":"WageHarbor","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://www.wageharbor.com/","description":"Payroll and HR for small businesses.","publisher":{"@@id":"https://www.wageharbor.com/#org"},"offers":{"@@type":"Offer","price":"0","priceCurrency":"USD","description":"Free for one person on payroll; then $12 a month plus $1.50 per person"}}]}</script>
</SeoTags>

<section class="lp-hero full-bleed">
    <div class="lp-wrap lp-hero-grid">
        <div>
            <span class="lp-eyebrow"><i class="bi bi-stars me-1"></i>@L["Free for 1 employee · ¼ the price after that"]</span>
            <h1>@L["Payroll and HR,"]<br /><span>@L["done right."]</span></h1>
            <p class="lp-lead">@L["Run payroll in minutes, pay your people on time, and give every employee their own login for pay stubs, time off and the time clock."]</p>
            <div class="d-flex flex-wrap gap-2">
                <a href="Account/Register" class="btn btn-lg btn-primary"><i class="bi bi-rocket-takeoff me-1"></i>@L["Register your company"]</a>
                <a href="help/company" class="btn btn-lg btn-outline-light">@L["See how it works"]</a>
            </div>
            <ul class="lp-hero-points">
                <li><i class="bi bi-check-circle-fill"></i>@L["No credit card"]</li>
                <li><i class="bi bi-check-circle-fill"></i>@L["Set up in an afternoon"]</li>
                <li><i class="bi bi-check-circle-fill"></i>@L["Encrypted SSNs & bank data"]</li>
            </ul>
        </div>
        <div class="lp-hero-shot">
            <img src="help/img/admin-dashboard.jpg" alt="@L["The WageHarbor dashboard for a small coffee company"]" width="1280" height="800" />
        </div>
    </div>
</section>

<section id="features" class="lp-section">
    <div class="lp-head">
        <h2>@L["Everything a small team needs"]</h2>
        <p>@L["From the first hire to year-end forms, in one place."]</p>
    </div>
    <div class="lp-features">
        <div class="lp-feature"><i class="bi bi-calculator"></i><h3>@L["Automatic payroll taxes"]</h3><p>@L["Federal income tax, Social Security, Medicare, state withholding, FUTA and SUTA, worked out for every paycheck."]</p></div>
        <div class="lp-feature"><i class="bi bi-bank"></i><h3>@L["Direct deposit"]</h3><p>@L["Split pay across accounts and download a NACHA ACH file for your bank. Paper checks work too."]</p></div>
        <div class="lp-feature"><i class="bi bi-receipt"></i><h3>@L["Pay stubs with your logo"]</h3><p>@L["Every employee can view, print or save their pay stubs as PDF, with your company name and logo on top."]</p></div>
        <div class="lp-feature"><i class="bi bi-clock-history"></i><h3>@L["Time clock & overtime"]</h3><p>@L["Employees clock in and out from any device. Managers approve time, and overtime is calculated for you."]</p></div>
        <div class="lp-feature"><i class="bi bi-sun"></i><h3>@L["Time off & holidays"]</h3><p>@L["Vacation and sick-leave accruals, requests and approvals, and a company holiday calendar."]</p></div>
        <div class="lp-feature"><i class="bi bi-file-earmark-bar-graph"></i><h3>@L["Reports & year-end"]</h3><p>@L["Payroll register, tax liability, Form 941 worksheet, W-2 and 1099 summaries. Export to CSV for your accountant."]</p></div>
    </div>
</section>

<section class="lp-section lp-steps-section">
    <div class="lp-head">
        <h2>@L["Up and running in three steps"]</h2>
        <p>@L.Html("The <a href=\"help/company\">company guide</a> walks you through each one with pictures.")</p>
    </div>
    <div class="lp-steps">
        <div><span class="num">1</span><h3>@L["Register your company"]</h3><p>@L["Name, state, your email and a password. That's it. You're the company's admin."]</p></div>
        <div><span class="num">2</span><h3>@L["Add your people"]</h3><p>@L["Pay rates, W-4s and bank details. Invite each employee with their own login."]</p></div>
        <div><span class="num">3</span><h3>@L["Run payroll"]</h3><p>@L["Calculate, review, approve, then mark it paid. Pay stubs appear for your team straight away."]</p></div>
    </div>
</section>

<section class="lp-mission full-bleed">
    <div class="lp-wrap">
        <i class="bi bi-quote lp-mission-mark"></i>
        <blockquote>@L["“Give the worker his wages before his sweat dries.”"]</blockquote>
        <div class="lp-mission-src">@L["Prophet Muhammad ﷺ · Sunan Ibn Majah 2443"]</div>
        <p>@L["WageHarbor exists for one simple idea: people should be paid correctly and on time. We built it so every small business, from a corner café to a growing crew, can do that without expensive software."] <a href="about">@L["Read our story →"]</a></p>
    </div>
</section>

<section class="lp-section lp-split">
    <div>
        <span class="lp-eyebrow-dark">@L["For employees"]</span>
        <h2>@L["Everyone gets their own login"]</h2>
        <p>@L["Your team sees their pay without having to ask HR:"]</p>
        <ul class="lp-checks">
            <li><i class="bi bi-check2"></i>@L["Pay stubs and year-to-date totals, ready to print or save as PDF"]</li>
            <li><i class="bi bi-check2"></i>@L["Clock in and out, or enter hours"]</li>
            <li><i class="bi bi-check2"></i>@L["Request time off and see balances"]</li>
            <li><i class="bi bi-check2"></i>@L["Update address and W-4 themselves"]</li>
        </ul>
        <a href="help/employee" class="fw-semibold">@L["Read the employee guide →"]</a>
    </div>
    <div class="lp-shot"><img src="help/img/employee-paystub.jpg" alt="@L["An employee's pay stub with the company logo"]" loading="lazy" width="1280" height="800" /></div>
</section>

<section class="lp-section lp-split lp-split-reverse">
    <div>
        <span class="lp-eyebrow-dark">@L["Security"]</span>
        <h2>@L["Built to keep payroll private"]</h2>
        <ul class="lp-checks">
            <li><i class="bi bi-shield-lock"></i>@L["Social Security and bank numbers are encrypted and always shown masked"]</li>
            <li><i class="bi bi-building-lock"></i>@L["Every company's data is kept separate. Other companies can never see yours"]</li>
            <li><i class="bi bi-person-check"></i>@L["Roles for Admin, HR, Payroll, Manager and Employee, plus two-step sign-in"]</li>
            <li><i class="bi bi-journal-text"></i>@L["An audit log of who changed what, and when"]</li>
        </ul>
        <a href="security" class="fw-semibold">@L["How we protect your data →"]</a>
    </div>
    <div class="lp-shot"><img src="help/img/admin-payroll-run.jpg" alt="@L["A payroll run with totals and paychecks"]" loading="lazy" width="1280" height="800" /></div>
</section>

<section id="pricing" class="lp-section">
    <div class="lp-head">
        <h2>@L["About a quarter of the price"]</h2>
        <p>@L["We're here to serve, not to squeeze. Every feature is included in every plan."]</p>
    </div>
    <div class="lp-plans">
        <div class="lp-price">
            <div class="pr-plan-name">@L["Solo"]</div>
            <div class="lp-price-tag">@L["Free"]</div>
            <p class="text-muted">@L["For a company with one person on payroll."]</p>
            <a href="Account/Register" class="btn btn-outline-primary btn-lg w-100">@L["Start free"]</a>
        </div>
        <div class="lp-price">
            <div class="pr-plan-name">@L["Team"]</div>
            <div class="lp-price-tag">$12<span>@L["/month"]</span></div>
            <p class="text-muted">@L["+ $1.50 per person on payroll. 10 people = $27/month, about ¼ of typical payroll apps."]</p>
            <a href="Account/Register" class="btn btn-primary btn-lg w-100">@L["Register your company"]</a>
        </div>
    </div>
    <div class="lp-trust mt-4">
        <span><i class="bi bi-credit-card"></i>@L["No setup fees"]</span>
        <span><i class="bi bi-x-circle"></i>@L["No contracts"]</span>
        <span><i class="bi bi-megaphone"></i>@L["No ads"]</span>
        <span><i class="bi bi-shield-check"></i>@L["We never sell your data"]</span>
    </div>
    <p class="text-center mt-3"><a href="pricing" class="fw-semibold">@L["See the price calculator and compare →"]</a></p>
</section>

<section class="lp-section">
    <div class="lp-head"><h2>@L["Questions and answers"]</h2></div>
    <div class="lp-faq">
        <details open><summary>@L["Why is WageHarbor so affordable? What's the catch?"]</summary><p>@L["There isn't one. WageHarbor was built so small businesses can pay their people correctly and on time without expensive software. We're here to serve, not to squeeze, so we charge about a quarter of what similar apps do, just enough to run the service well, and nothing if you have one person on payroll. We don't show ads and we don't sell or share your company's or employees' data. Your records always stay yours to print and export. See"] @L.Html("<a href=\"pricing\">Pricing</a>, our <a href=\"terms\">Terms</a> and <a href=\"privacy\">Privacy policy</a>.")</p></details>
        <details><summary>@L["Who is WageHarbor for?"]</summary><p>@L["US small businesses with salaried, hourly and contract (1099) workers who want to run payroll themselves, with clear pay stubs and self-service for their team."]</p></details>
        <details><summary>@L["Does WageHarbor file my payroll taxes?"]</summary><p>@L["No. WageHarbor calculates withholding and employer taxes and gives you the totals and reports (tax liability, Form 941 worksheet, W-2 and 1099 summaries). You or your accountant make the deposits and filings."]</p></details>
        <details><summary>@L["How do employees get paid?"]</summary><p>@L["By direct deposit, using the ACH file WageHarbor creates for your bank, or by paper check."]</p></details>
        <details><summary>@L["Can my bookkeeper or accountant use it?"]</summary><p>@L["Yes. Give them a login with the Payroll or HR role, and they can run reports and export CSV files."]</p></details>
        <details><summary>@L["Is my data safe?"]</summary><p>@L["Sensitive numbers are encrypted, each company's data is kept separate, and access is based on roles. See"] @L.Html("<a href=\"security\">Security</a> for details.")</p></details>
    </div>
</section>

<section class="lp-cta full-bleed">
    <div class="lp-wrap text-center">
        <h2>@L["Pay your people right, starting today."]</h2>
        <p>@L["Register in two minutes. Free for 1 employee, about ¼ the usual price after that."]</p>
        <a href="Account/Register" class="btn btn-lg btn-light"><i class="bi bi-rocket-takeoff me-1"></i>@L["Register your company"]</a>
    </div>
</section>
