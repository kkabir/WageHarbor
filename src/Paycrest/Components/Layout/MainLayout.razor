@inherits LayoutComponentBase
@inject Db Dbs
@inject CurrentUser Me
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="@L["Toggle navigation"]" />
        <div class="app-shell">
            <aside class="app-sidebar">
                <NavMenu />
            </aside>
            <div class="app-main">
                <header class="app-topbar">
                    <label for="menu-toggle" class="menu-btn"><i class="bi bi-list"></i></label>
                    <span class="company">
                        @if (logoVersion != null)
                        {
                            <img class="company-logo" src="company-logo?v=@logoVersion" alt="" />
                        }
                        else
                        {
                            <i class="bi bi-buildings text-muted"></i>
                        }
                        <span class="company-name">@companyName</span>
                    </span>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <LanguagePicker Class="d-none d-md-flex" />
                        <ThemeToggle />
                        <div class="dropdown">
                            <a class="d-flex align-items-center gap-2 text-reset" href="Account/Manage" title="@L["Account settings"]">
                                <span class="avatar">@Initials(context.User.Identity?.Name)</span>
                                <span class="d-none d-md-inline small fw-semibold">@context.User.Identity?.Name</span>
                            </a>
                        </div>
                        <form action="Account/Logout" method="post" class="m-0">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="@L["Sign out"]"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </div>
                </header>
                <main class="app-content">
                    @if (unconfirmedEmail != null && !Nav.Uri.Contains("/Account/ConfirmEmail", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 small py-2" role="status">
                            <i class="bi bi-envelope-exclamation"></i>
                            <span>@L.Html("Please confirm your email address. We sent a link to <strong>{0}</strong>.", System.Net.WebUtility.HtmlEncode(unconfirmedEmail))</span>
                            <a class="ms-auto fw-semibold" href="Account/ResendEmailConfirmation">@L["Send it again"]</a>
                        </div>
                    }
                    @Body
                </main>
            </div>
        </div>
        <Toasts />
    </Authorized>
    <NotAuthorized>
        <div class="auth-wrap">
            <section class="auth-hero">
                <img src="brand/wageharbor-logo-dark.svg" alt="WageHarbor" height="44" />
                <div>
                    <h2>@L["Payroll and HR,"]<br />@L["done right."]</h2>
                    <p class="opacity-75 mb-4">@L["Run payroll in minutes, keep every employee record in one place, and give your team self-service access to pay, time and benefits."]</p>
                    <ul>
                        <li><i class="bi bi-check-circle-fill"></i>@L["Automatic federal, FICA, state & unemployment taxes"]</li>
                        <li><i class="bi bi-check-circle-fill"></i>@L["Direct deposit with NACHA ACH files"]</li>
                        <li><i class="bi bi-check-circle-fill"></i>@L["Time clock, overtime and PTO accruals"]</li>
                        <li><i class="bi bi-check-circle-fill"></i>@L["Employee self-service & digital pay stubs"]</li>
                        <li><i class="bi bi-check-circle-fill"></i>@L["941, 940 and W-2 reporting"]</li>
                    </ul>
                </div>
                <div>
                    <a href="help" class="auth-help-link"><i class="bi bi-question-circle me-1"></i>@L["Help & user guides"]</a>
                    <small class="d-block opacity-50 mt-2">@L["Encrypted SSNs and bank data · Role-based access · Full audit trail"]</small>
                </div>
            </section>
            <section class="auth-panel">
                <div class="d-flex justify-content-end mb-3"><LanguagePicker /></div>
                <div>@Body</div>
            </section>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    @L["An unhandled error has occurred."]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string companyName = "";
    private long? logoVersion;
    private string? unconfirmedEmail;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbs.OpenAsync();
        companyName = await db.Companies.Select(c => c.Name).FirstOrDefaultAsync() ?? "WageHarbor";
        logoVersion = await db.CompanyLogos.Select(l => (long?)l.UpdatedUtc.Ticks).FirstOrDefaultAsync();
        var userId = await Me.GetUserIdAsync();
        unconfirmedEmail = userId == null ? null
            : await db.Users.Where(u => u.Id == userId && !u.EmailConfirmed).Select(u => u.Email).FirstOrDefaultAsync();
    }

    private static string Initials(string? name) =>
        string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
}
