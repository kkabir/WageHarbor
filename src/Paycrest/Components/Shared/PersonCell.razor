<div class="person">
    <span class="avatar">@Initials</span>
    <div class="min-w-0">
        <div class="name text-truncate">@Name</div>
        @if (!string.IsNullOrEmpty(Sub))
        {
            <div class="sub text-truncate">@Sub</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Sub { get; set; }

    private string Initials => string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
