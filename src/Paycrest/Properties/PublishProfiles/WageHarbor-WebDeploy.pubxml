<?xml version="1.0" encoding="utf-8"?>
<!-- Web Deploy to SmarterASP.NET (wageharbor.com). The password is never stored here: Visual Studio asks for it,
     and publish.ps1 prompts for it. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://wageharbor.com/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <MSDeployServiceURL>https://win1209.site4now.net:8172/msdeploy.axd?site=kkabir84-001-site20</MSDeployServiceURL>
    <DeployIisAppPath>kkabir84-001-site20</DeployIisAppPath>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <UserName>kkabir84-001</UserName>
    <_SavePWD>false</_SavePWD>
    <!-- Takes the site offline (app_offline.htm) during upload so IIS releases the DLLs. -->
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <!-- Set to true only if publishing fails with a certificate error from win1209.site4now.net. -->
    <AllowUntrustedCertificate>false</AllowUntrustedCertificate>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Framework-dependent: requires .NET 10 selected in the SmarterASP control panel.
         If the site shows HTTP 500.31 after publishing, run publish.ps1 -SelfContained instead. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
